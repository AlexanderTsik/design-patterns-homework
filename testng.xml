<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Allure Configuration Suite" verbose="1">
    <listeners>
        <listener class-name="ge.tbc.testautomation.listeners.CustomSuiteListener" />
        <listener class-name="ge.tbc.testautomation.listeners.CustomTestListener" />
        <listener class-name="ge.tbc.testautomation.listeners.CustomReportListener" />
    </listeners>
    <!-- First Test Tag -->
    <test name="Selenide Tests">
        <!-- Define Grouping -->
        <groups>
            <define name="SelenideTests1">
            </define>

            <define name="SelenidTestse2">
            </define>

            <define name="SelenideGroup">
                <include name="Selenide1"/>
                <include name="Selenide2"/>
            </define>
        </groups>

        <!-- Include Methods -->
        <classes>
            <class name="ge.tbc.testautomation.tests.SelenideTests1"/>
            <class name="ge.tbc.testautomation.tests.SelenideTests2"/>
        </classes>
    </test>

    <!-- Second Test Tag -->
    <test name="FrontEnd Tests">
        <!-- Run Groups Ending with FrontEnd -->
        <groups>
            <run>
                <include name=".*FrontEnd"/>
            </run>
        </groups>

        <!-- Execution Sequence -->


        <classes>
            <class name="ge.tbc.testautomation.tests.SelenideTests1"/>
        </classes>
    </test>
</suite>
